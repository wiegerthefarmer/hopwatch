          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "bargauge",
      "title": "TLS certificate expires in",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 55
      },
      "targets": [
        {
