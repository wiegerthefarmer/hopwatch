{
  "uid": "hopwatch",
  "title": "hopwatch",
  "tags": [
    "mtr",
    "network"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Source",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "vm"
        },
        "query": {
          "query": "label_values(mtr_run_success, source)",
          "refId": "source"
        },
        "definition": "label_values(mtr_run_success, source)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "target",
        "label": "Target",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "vm"
        },
        "query": {
          "query": "label_values(mtr_run_success{source=\"$source\"}, target)",
          "refId": "target"
        },
        "definition": "label_values(mtr_run_success{source=\"$source\"}, target)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "http_instance",
        "label": "HTTP target",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "vm"
        },
        "query": {
          "query": "label_values(probe_http_duration_seconds, instance)",
          "refId": "http_instance"
        },
        "definition": "label_values(probe_http_duration_seconds, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview (all sources and targets)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Destination latency (avg)",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "mtr_dest_rtt_avg_ms",
          "legendFormat": "{{source}} → {{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Destination packet loss",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "mtr_dest_loss_percent",
          "legendFormat": "{{source}} → {{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Route changes per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "changes(mtr_path_hash[1h])",
          "legendFormat": "{{source}} → {{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "How often the sequence of hop IPs changed. Frequent changes usually mean load balancing (ECMP) or route flapping."
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "Collector runs",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "mtr_run_success",
          "legendFormat": "{{source}} → {{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "failed",
                  "color": "red"
                },
                "1": {
                  "text": "ok",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true
      },
      "description": "Green = mtr completed. Red = failed (see collector logs: docker compose logs collector)."
    },
    {
      "id": 6,
      "type": "row",
      "title": "Path: $source → $target",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "table",
      "title": "Latest route (mtr report)",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "mtr_hop_loss_percent{source=\"$source\",target=\"$target\"} and (timestamp(mtr_hop_loss_percent{source=\"$source\",target=\"$target\"}) >= scalar(max(timestamp(mtr_path_hops{source=\"$source\",target=\"$target\"}))))",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "mtr_hop_rtt_avg_ms{source=\"$source\",target=\"$target\"} and (timestamp(mtr_hop_rtt_avg_ms{source=\"$source\",target=\"$target\"}) >= scalar(max(timestamp(mtr_path_hops{source=\"$source\",target=\"$target\"}))))",
          "legendFormat": "__auto",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "mtr_hop_rtt_best_ms{source=\"$source\",target=\"$target\"} and (timestamp(mtr_hop_rtt_best_ms{source=\"$source\",target=\"$target\"}) >= scalar(max(timestamp(mtr_path_hops{source=\"$source\",target=\"$target\"}))))",
          "legendFormat": "__auto",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "mtr_hop_rtt_worst_ms{source=\"$source\",target=\"$target\"} and (timestamp(mtr_hop_rtt_worst_ms{source=\"$source\",target=\"$target\"}) >= scalar(max(timestamp(mtr_path_hops{source=\"$source\",target=\"$target\"}))))",
          "legendFormat": "__auto",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "mtr_hop_rtt_stdev_ms{source=\"$source\",target=\"$target\"} and (timestamp(mtr_hop_rtt_stdev_ms{source=\"$source\",target=\"$target\"}) >= scalar(max(timestamp(mtr_path_hops{source=\"$source\",target=\"$target\"}))))",
          "legendFormat": "__auto",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "mtr_hop_sent{source=\"$source\",target=\"$target\"} and (timestamp(mtr_hop_sent{source=\"$source\",target=\"$target\"}) >= scalar(max(timestamp(mtr_path_hops{source=\"$source\",target=\"$target\"}))))",
          "legendFormat": "__auto",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Loss %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 10
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Hops from the most recent run. ??? = hop did not reply (common for routers that rate-limit ICMP; only loss that continues to the destination matters).",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "source": true,
              "target": true,
              "__name__": true
            },
            "indexByName": {
              "hop": 0,
              "hop_ip": 1,
              "asn": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6,
              "Value #E": 7,
              "Value #F": 8
            },
            "renameByName": {
              "hop": "Hop",
              "hop_ip": "Host",
              "asn": "ASN",
              "Value #A": "Loss %",
              "Value #B": "Avg ms",
              "Value #C": "Best ms",
              "Value #D": "Worst ms",
              "Value #E": "StDev ms",
              "Value #F": "Sent"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Hop",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Hop"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Destination latency spread (smoke)",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "mtr_dest_rtt_best_ms{source=\"$source\",target=\"$target\"}",
          "legendFormat": "best",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "mtr_dest_rtt_avg_ms{source=\"$source\",target=\"$target\"}",
          "legendFormat": "avg",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "mtr_dest_rtt_worst_ms{source=\"$source\",target=\"$target\"}",
          "legendFormat": "worst",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "ms"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "worst"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "best"
              },
              {
                "id": "custom.fillOpacity",
                "value": 25
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "best"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "avg"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Shaded band = best..worst RTT within each run; line = average. A wide band means jitter."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Destination loss",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "mtr_dest_loss_percent{source=\"$source\",target=\"$target\"}",
          "legendFormat": "loss",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Per-hop latency (avg)",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "mtr_hop_rtt_avg_ms{source=\"$source\",target=\"$target\"}",
          "legendFormat": "{{hop}} {{hop_ip}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "A step up that persists to every later hop points at the hop where latency is added."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Per-hop loss",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "mtr_hop_loss_percent{source=\"$source\",target=\"$target\"}",
          "legendFormat": "{{hop}} {{hop_ip}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "HTTP/S and ping (blackbox_exporter)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "state-timeline",
      "title": "Probe success",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 47
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "probe_success",
          "legendFormat": "{{job}} {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "HTTP timing by phase: $http_instance",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 47
      },
      "targets": [
