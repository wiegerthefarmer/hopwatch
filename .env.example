# Copy to .env and adjust. docker compose reads .env automatically.

# Grafana admin password (user: admin)
GRAFANA_ADMIN_PASSWORD=change-me

# Optional: raises the Globalping hourly test limit. Create one at https://dash.globalping.io
GLOBALPING_TOKEN=

# How long VictoriaMetrics keeps data (e.g. 90d, 1y, 5y)
RETENTION=1y

TZ=Etc/UTC
